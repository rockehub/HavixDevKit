{
  "name": "category-grid-custom",
  "title": "Category Grid",
  "description": "Exibe até 3 categorias em cards com imagem full-size, overlay e efeito de zoom.",
  "category": "Commerce",
  "icon": "grid",
  "version": "1.1.1",
  "allowMultiple": false,
  "supportedPageTypes": ["HOME", "CONTENT"],
  "fields": [
    {
      "id": "content.count",
      "label": "Número de categorias",
      "type": "range",
      "defaultValue": 3,
      "section": "content",
      "min": 1,
      "max": 3
    },
    {
      "id": "content.featuredOnly",
      "label": "Apenas categorias em destaque",
      "type": "boolean",
      "defaultValue": true,
      "section": "content"
    },
    {
      "id": "content.buttonText",
      "label": "Texto do botão",
      "type": "text",
      "defaultValue": "Compre agora",
      "section": "content"
    },
    {
      "id": "style.gap",
      "label": "Espaço entre cards (px)",
      "type": "range",
      "defaultValue": 4,
      "section": "style",
      "min": 0,
      "max": 24
    }
  ],
  "buttons": []
}
